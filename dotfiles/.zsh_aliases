[ -f ~/.kubectl_aliases.zsh ] && source ~/.kubectl_aliases.zsh

alias reload='source "${ZDOTDIR:-$HOME}/.zshrc"'
alias gbd!="git branch -D"
alias gdc="git diff --cached"
alias glow="glow -p -w 120"
# SSH through Tailscale's own name lookup, bypassing GlobalProtect's DNS.
alias tssh="ssh -o ProxyCommand='tailscale nc %h %p'"
