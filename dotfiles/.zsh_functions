_review_base_branch() {
  local ref

  for ref in main master origin/main origin/master upstream/main upstream/master; do
    if git rev-parse --verify --quiet "${ref}^{commit}" >/dev/null 2>&1; then
      print -r -- "$ref"
      return 0
    fi
  done

  print -u2 "review: could not find a main or master base branch"
  return 1
}

codex() {
  if [ -n "${ZELLIJ:-}" ]; then
    command codex --no-alt-screen "$@"
  else
    command codex "$@"
  fi
}

_codex_review() {
  local -a pipeline_status

  codex exec --ephemeral --color always review \
    -m gpt-5.5 \
    -c 'model_reasoning_effort="medium"' \
    -c 'service_tier="fast"' \
    "$@"

  pipeline_status=("${pipestatus[@]}")
  return "${pipeline_status[1]}"
}

review() {
  local base

  base="$(_review_base_branch)" || return
  _codex_review --base "$base" "$@"
}

review-commit() {
  _codex_review --uncommitted "$@"
}

switch() {
  local repo_root="${HOME}/Projects/nix-home-manager-config"
  local system

  system="$(nix eval --impure --raw --expr 'builtins.currentSystem')" || return
  home-manager switch --flake "path:${repo_root}#${system}" --impure || return
}

muse() {
  local tool="$1"
  mise use --global "$tool@$(mise latest "$tool")"
}

mise-union() {
  setopt localoptions pipefail
  local config_file dependency rows
  local scan_status=0

  for dependency in mise fd jq awk; do
    if (( ! $+commands[$dependency] )); then
      print -u2 "mise-union: requires $dependency"
      return 127
    fi
  done

  rows="$(
    command fd --hidden --no-ignore --type f --print0 --exclude '/.cargo' \
      --exclude '/Library' --exclude '/go' --exclude '/.cursor' \
      --glob 'mise.toml' "$HOME" 2>/dev/null |
      {
        while IFS= read -r -d $'\0' config_file; do
          if ! mise ls --cd "${config_file:h}" --json; then
            print -u2 "mise-union: could not list tools in ${config_file:h}"
            scan_status=1
          fi
        done
        return "$scan_status"
      } |
      command jq -sr --arg home "$HOME/" '
        [ .[] | to_entries[] | .key as $tool | .value[] |
          [ $tool, .version, (.source.path // ""), (.requested_version // "") ]
        ] | unique | group_by(.[0:2])[] |
        if any(.[]; .[2] != "") then .[] | select(.[2] != "") else .[] end |
        .[2] |= (if startswith($home) then "~/" + ltrimstr($home) else . end) |
        @tsv
      '
  )" || scan_status=$?

  {
    print -r -- $'Tool\tVersion\tSource\tRequested'
    [[ -z "$rows" ]] || print -r -- "$rows"
  } | command awk -F '\t' '
    {
      for (col = 1; col <= 4; col++) {
        cells[NR, col] = $col
        if (length($col) > widths[col]) widths[col] = length($col)
      }
    }
    END {
      for (row = 1; row <= NR; row++) {
        for (col = 1; col < 4; col++)
          printf "%-*s  ", widths[col], cells[row, col]
        printf "%s\n", cells[row, 4]
      }
    }
  '
  return "$scan_status"
}

# Wrap mise such that it knows how to auth with GitHub.
mise() {
  if [ -z "${MISE_GITHUB_TOKEN}" ]; then
    export MISE_GITHUB_TOKEN=$(command gh auth token 2>/dev/null)
  fi
  if typeset -f _mise_original > /dev/null 2>&1; then
    _mise_original "$@"
  else
    command mise "$@"
  fi
}
