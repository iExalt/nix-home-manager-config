_review_base_branch() {
  local ref

  for ref in main master origin/main origin/master upstream/main upstream/master; do
    if git rev-parse --verify --quiet "${ref}^{commit}" >/dev/null 2>&1; then
      print -r -- "$ref"
      return 0
    fi
  done

  print -u2 "review: could not find a main or master base branch"
  return 1
}

_codex_review() {
  local -a pipeline_status

  codex exec --ephemeral --color always review \
    -m gpt-5.5 \
    -c 'model_reasoning_effort="medium"' \
    -c 'service_tier="fast"' \
    "$@"

  pipeline_status=("${pipestatus[@]}")
  return "${pipeline_status[1]}"
}

review() {
  local base

  base="$(_review_base_branch)" || return
  _codex_review --base "$base" "$@"
}

review-commit() {
  _codex_review --uncommitted "$@"
}

switch() {
  local repo_root="${HOME}/Projects/nix-home-manager-config"
  local system

  system="$(nix eval --impure --raw --expr 'builtins.currentSystem')" || return
  home-manager switch --flake "path:${repo_root}#${system}" --impure || return
}

muse() {
  local tool="$1"
  mise use --global "$tool@$(mise latest "$tool")"
}

# Wrap mise such that it knows how to auth with GitHub.
mise() {
  if [ -z "${MISE_GITHUB_TOKEN}" ]; then
    export MISE_GITHUB_TOKEN=$(command gh auth token 2>/dev/null)
  fi
  if typeset -f _mise_original > /dev/null 2>&1; then
    _mise_original "$@"
  else
    command mise "$@"
  fi
}
